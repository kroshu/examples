<?xml version="1.0" encoding="utf-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="multi_kr6_r700_2">
  <xacro:include filename="$(find kuka_kr_moveit_config)/srdf/kr_arm_macro.xacro"/>

  <xacro:kuka_kr_arm prefix="robot1_"/>
  <xacro:kuka_kr_arm prefix="robot2_"/>

  <group name="dual_manipulator">
    <group name="robot1_manipulator"/>
    <group name="robot2_manipulator"/>
  </group>

  <disable_collisions link1="robot1_base_link" link2="robot2_base_link" reason="Never"/>
</robot>
